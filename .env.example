# ---------------------------------------------------------------------------
# Marketing Connector Platform — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

APP_NAME="Marketing Connector Platform"
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # exposes /docs; MUST be false outside development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database
# SQLite (default) needs no server and is fine for local dev + tests.
# Postgres is the supported production target — install the extra:
#   pip install -e ".[postgres]"
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/connectors
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./connectors.db
DB_ECHO=false

# ---------------------------------------------------------------------------
# Encryption — protects OAuth refresh/access tokens at rest (Fernet, AES-128-CBC
# + HMAC). Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, keep old keys after it (comma-separated).
# Existing rows stay readable and are re-encrypted on next write.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# API bearer token for the local/dev tenant. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave blank in development to auto-issue a printed dev token.
API_TOKEN=

# ---------------------------------------------------------------------------
# Google OAuth  (Google Analytics 4, Search Console, Google Ads)
# One OAuth client serves all three — see docs/OAUTH_SETUP.md.
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Google Ads only. Obtained from your Google Ads manager account
# (API Center). Without it the Google Ads connector reports
# INVALID_CONFIGURATION instead of failing obscurely.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google sunsets an Ads API version roughly every quarter; bump this rather
# than editing code. Supported at time of writing: v23, v24, v25.
GOOGLE_ADS_API_VERSION=v25
# Optional: manager (MCC) account id used as login-customer-id, digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Meta OAuth  (Meta Ads, Instagram Insights)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/meta/callback
# Meta expires a Graph API version ~2 years after release. Newest: v26.0.
META_API_VERSION=v26.0

# ---------------------------------------------------------------------------
# LeadSquared  (CRM: leads + every activity type) — static key pair, not OAuth
# ---------------------------------------------------------------------------
# These MUST be set in the environment of the process that runs the SCHEDULER
# (the production service), not only on the machine an operator triggers manual
# syncs from. A scheduler process missing them fails every scheduled run with
# "LeadSquared is not configured" while manual runs elsewhere keep succeeding.
LEADSQUARED_ACCESS_KEY=
LEADSQUARED_SECRET_KEY=
# The account's regional API host (no trailing slash), e.g. https://api-in21.leadsquared.com
LEADSQUARED_HOST=https://api.leadsquared.com
# The API budget belongs to the whole account (other systems use it too); the limiter is
# shared by every LeadSquared client in the process and halves itself on a 429.
LEADSQUARED_RATE_PER_SECOND=0.5
LEADSQUARED_BURST=2

# ---------------------------------------------------------------------------
# Sync engine
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30        # how often to look for due connections
MAX_CONCURRENT_SYNCS=4           # platform-wide cap on simultaneous sync runs
SYNC_RUN_TIMEOUT_SECONDS=10800   # hard ceiling per run (3h) — prevents hangs
DEFAULT_LOOKBACK_DAYS=3          # re-fetch window for late-arriving analytics data
DEFAULT_BACKFILL_DAYS=90
HTTP_TIMEOUT_SECONDS=120
# A connection is a LEASE: the worker running it renews it every SYNC_HEARTBEAT_SECONDS,
# and a lease not renewed for SYNC_LEASE_SECONDS is treated as dead and taken over. So a
# crashed worker is recovered in minutes, and a live long run is never mistaken for dead.
SYNC_LEASE_SECONDS=300
SYNC_HEARTBEAT_SECONDS=60
# Optional stable identity for this process (must be UNIQUE per running process). With it
# set, a restart reclaims its own previous incarnation's locks immediately.
WORKER_ID=
