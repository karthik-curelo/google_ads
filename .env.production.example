# ---------------------------------------------------------------------------
# Marketing Connector Platform — PRODUCTION environment checklist
#
# This is not a second copy of .env.example — it only calls out what MUST be
# different in production. Start from .env.example, then apply every change
# below. Values left blank here must be generated/obtained fresh for
# production — never reuse a development secret.
# ---------------------------------------------------------------------------

# --- Flip these three — they change real code paths, not just labels -------
ENVIRONMENT=production            # disables Base.metadata.create_all (app/main.py) —
                                   # Alembic (`alembic upgrade head`) becomes the ONLY
                                   # way the schema is created/changed. Run migrations
                                   # as a deploy step, before starting the app.
DEBUG=false                       # true exposes /docs (the OpenAPI/Swagger UI) publicly
LOG_LEVEL=INFO                    # DEBUG-level logging can leak request bodies

# --- Must match the real deployed host, not localhost -----------------------
PUBLIC_BASE_URL=https://REPLACE_ME
FRONTEND_BASE_URL=https://REPLACE_ME
GOOGLE_REDIRECT_URI=https://REPLACE_ME/api/v1/oauth/google/callback
META_REDIRECT_URI=https://REPLACE_ME/api/v1/oauth/meta/callback
# ^ These two redirect URIs must ALSO be re-registered as authorized redirect
#   URIs in the Google Cloud Console OAuth client and the Meta App dashboard
#   respectively — the OAuth handshake fails with a mismatch error otherwise.
#   Do this BEFORE flipping DNS/traffic to the new host, or reconnecting any
#   integration will break.

# --- ENCRYPTION_KEY, API_TOKEN ----------------------------------------------
# Also carrying the current values over as-is, same decision as below. If you
# ever do want to rotate ENCRYPTION_KEY specifically, it's the one zero-
# downtime case: put the NEW key first, comma-separate the old key(s) after
# it — existing encrypted tokens stay readable under the old key and get
# re-encrypted under the new one automatically on their next write.

# --- DATABASE_URL, GOOGLE_CLIENT_SECRET, GOOGLE_ADS_DEVELOPER_TOKEN,
#     META_APP_SECRET --------------------------------------------------------
# Carry the current live values over as-is (decision: not rotating these for
# this deploy). If that changes later, rotating needs a matching change on
# the provider's side in the same window — Postgres (ALTER USER ...
# PASSWORD), Google Cloud Console, Meta App dashboard — done together so
# nothing is left pointing at a revoked credential.
# Wherever these actually live in production, prefer a secret store (GCP
# Secret Manager, etc.) over a bare .env file on disk — this file is a
# checklist of what production needs set, not itself where secrets should
# live long-term.

# --- LEADSQUARED_ACCESS_KEY, LEADSQUARED_SECRET_KEY, LEADSQUARED_HOST -------------
# REQUIRED IN THE SERVICE'S OWN .env. These were once added only to a developer's
# .env: the production scheduler then failed every scheduled LeadSquared run with
# "LeadSquared is not configured" (nine in a row) while manual runs from a machine that
# had them kept succeeding. The service now refuses to hide this: at startup it logs
# `PREFLIGHT: connection N ... cannot run in this process` at ERROR and flags the
# connection, and /healthz reports {"status": "degraded", "misconfigured": [...]}.
# Verify on the VM with:  ./.venv/bin/python -m app.sync.cli preflight
# LEADSQUARED_HOST is the account's regional API host, e.g. https://api-in21.leadsquared.com

# --- Everything else (sync engine tuning, Meta/Google API versions, etc.) --
# Carries over unchanged from .env.example — see that file.
