    "metrics.average_cpc": { "value": "high" },
    "metrics.average_cpm": { "value": "medium", "status": "missing" },
    "metrics.all_conversions": { "value": "high", "status": "missing" },
    "metrics.all_conversions_value": { "value": "high", "status": "missing" },
    "metrics.view_through_conversions": { "value": "medium", "status": "missing" },
    "metrics.cost_per_conversion": { "value": "medium", "status": "missing" },
