    "firstUserDefaultChannelGroup": { "value": "high" }, "firstUserSource": { "value": "high" },
    "firstUserMedium": { "value": "high" }, "firstUserCampaignName": { "value": "high" },
    "firstUserSourceMedium": { "value": "medium" }, "firstUserGoogleAdsCampaignName": { "value": "medium" },
    "newVsReturning": { "value": "high" },
    "userAgeBracket": { "value": "high" }, "userGender": { "value": "high" },
    "brandingInterest": { "value": "medium" }, "audienceName": { "value": "medium" },
