    "isoWeek": { "value": "low" }, "nthDay": { "value": "low" }, "dayOfWeek": { "value": "low" },
    "hour": { "value": "medium" },
    "country": { "value": "high" }, "region": { "value": "high" }, "city": { "value": "high" },
