    "screenResolution": { "value": "medium" }, "platform": { "value": "medium" },
    "appVersion": { "value": "medium" }, "streamName": { "value": "low" },
    "pagePath": { "value": "high" }, "pagePathPlusQueryString": { "value": "medium" },
    "pageTitle": { "value": "high" }, "pageReferrer": { "value": "medium" },
    "landingPage": { "value": "high" }, "landingPagePlusQueryString": { "value": "medium" },
    "hostName": { "value": "low" }, "fullPageUrl": { "value": "low" },
    "eventName": { "value": "high" }, "isKeyEvent": { "value": "medium" },
    "sessionDefaultChannelGroup": { "value": "high" }, "sessionSource": { "value": "high" },
