{
  "source": "google_analytics",
  "connector_id": "google_analytics",
  "refresh": "GET https://analyticsdata.googleapis.com/v1beta/properties/{id}/metadata",
  "review_by": "2026-12-01",
  "report_methods": {
    "runReport": { "value": "high", "status": "implemented" },
    "batchRunReports": { "value": "low", "status": "unsupported", "note": "optimisation only; runReport per stream is fine" },
    "runPivotReport": { "value": "low", "status": "unsupported" },
    "runRealtimeReport": { "value": "low", "status": "unsupported", "note": "no history; not warehouse-shaped" },
    "runFunnelReport": { "value": "low", "status": "unsupported", "note": "needs a funnel spec per property; out of scope for generic ingest" }
  },
  "dimensions": {
    "date": { "value": "high" },
    "dateHour": { "value": "medium" },
    "dateHourMinute": { "value": "low", "status": "unsupported" },
